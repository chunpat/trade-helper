# Application Settings
APP_NAME=trade-helper
ENVIRONMENT=development
DEBUG=True
API_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:8030

# Monitoring Settings
ENABLE_METRICS=True
PROMETHEUS_METRICS_PORT=9090
GRAFANA_PASSWORD=admin
NODE_EXPORTER_PORT=9100
MYSQL_EXPORTER_PORT=9104
REDIS_EXPORTER_PORT=9121

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=trade_helper
DB_CHARSET=utf8mb4

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Settings
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Exchange API Settings
BINANCE_API_KEY=your-binance-api-key
BINANCE_API_SECRET=your-binance-api-secret
# Market data poll interval (seconds)
MARKET_POLL_INTERVAL=10

# Risk Control Settings
MAX_LEVERAGE=20
MAX_POSITION_VALUE=1000000
RISK_RATIO_THRESHOLD=0.8
MAX_SINGLE_ORDER=100000
PRICE_DEVIATION_LIMIT=0.05
ORDER_FREQUENCY_LIMIT=10

# AI Analysis
# ENABLE_GPT_5_1 只控制看板里的本地摘要文案，不会发起远程 OpenAI 调用
ENABLE_GPT_5_1=False
ANOMALY_LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
NEWS_PROVIDER=auto
NEWS_API_KEY=
NEWS_API_BASE_URL=https://cryptopanic.com/api/developer/v2/posts/
NEWS_API_TIMEOUT_SECONDS=12
NEWS_ENABLE_BINANCE_ANNOUNCEMENTS=True
NEWS_BINANCE_ARTICLE_LIST_URL=https://www.binance.com/bapi/composite/v1/public/cms/article/list/query
NEWS_BINANCE_ARTICLE_PAGE_SIZE=3
NEWS_BINANCE_CATALOG_LIMIT=8
NEWS_ENABLE_OKX_ANNOUNCEMENTS=True
NEWS_OKX_ANNOUNCEMENTS_URL=https://www.okx.com/help/section/announcements-new-listings
NEWS_ENABLE_BYBIT_ANNOUNCEMENTS=True
NEWS_BYBIT_ANNOUNCEMENTS_URL=https://announcements.bybit.com/en-US/
NEWS_ENABLE_COINBASE_BLOG=True
NEWS_COINBASE_BLOG_URL=https://www.coinbase.com/blog/landing
NEWS_OFFICIAL_PAGE_ITEM_LIMIT=12
NEWS_RSS_FEED_URLS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://decrypt.co/feed,https://blockworks.co/feed,https://www.theblock.co/rss.xml,https://cryptoslate.com/feed/,https://bitcoinmagazine.com/feed,https://thedefiant.io/feed,https://ambcrypto.com/feed/,https://coingape.com/feed/,https://news.bitcoin.com/feed/
NEWS_RSS_CACHE_SECONDS=180
NEWS_RSS_PER_FEED_LIMIT=12
NEWS_GLOBAL_POOL_SIZE=80
NEWS_RSS_MAX_AGE_HOURS=72
NEWS_SEARCH_CACHE_SECONDS=600
NEWS_SEARCH_EMPTY_CACHE_SECONDS=180
NEWS_SYMBOL_ALIAS_MAP={"TRUMP":["official trump","trump token","trump memecoin","world liberty financial"]}
NEWS_SYMBOL_OFFICIAL_FEEDS={"KAT":["https://medium.com/feed/@katana"]}
NEWS_SYMBOL_OFFICIAL_FEED_CACHE_SECONDS=900
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1
BRAVE_NEWS_FRESHNESS=pd
ANOMALY_SCAN_INTERVAL=300
ANOMALY_TOP_N=100
ANOMALY_CANDIDATE_LIMIT=12
ANOMALY_ALERT_THRESHOLD=0.58
ANOMALY_COOLDOWN_MINUTES=30
ANOMALY_NEWS_LIMIT=6
MAX_DAILY_LOSS=50000
RISK_LEVEL_THRESHOLD=0.9

# Alert Settings
ENABLE_EMAIL_ALERTS=True
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
ALERT_RECIPIENTS=admin@example.com

# Webhook Settings
ENABLE_WEBHOOK_ALERTS=True
WEBHOOK_URL=https://your-webhook-url
WEBHOOK_SECRET=your-webhook-secret

# Telegram Bot Settings
ENABLE_TELEGRAM_ALERTS=False
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Enterprise WeChat Settings
ENABLE_WECHAT_ALERTS=False
WECHAT_CORP_ID=your-corp-id
WECHAT_AGENT_ID=your-agent-id
WECHAT_CORP_SECRET=your-corp-secret

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_PATH=/var/log/trade-helper
ENABLE_ELK_LOGGING=False
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601

# Frontend Settings
VUE_APP_API_URL=http://localhost:8029/api/v1
VUE_APP_WEBSOCKET_URL=ws://localhost:8029/ws
VUE_APP_ENABLE_MOCK=False

# Performance Settings
ENABLE_REDIS_CACHE=True
REDIS_CACHE_EXPIRE=3600
ENABLE_RATE_LIMIT=True
RATE_LIMIT_PER_MINUTE=60
